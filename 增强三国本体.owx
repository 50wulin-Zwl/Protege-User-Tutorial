        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#白龙马</IRI>
        <Literal xml:lang="zh">Individuals 页：故意没有显式类型；由「赵云 骑乘 白龙马」及 Range=马推出它的类型。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#刘玄德</IRI>
        <Literal xml:lang="zh">刘玄德</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#刘玄德</IRI>
        <Literal xml:lang="zh">Individuals 页：Same As 与刘备相同个体；演示别名与个体等同性，不是另一个历史人物。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#演示角色甲</IRI>
        <Literal xml:lang="zh">演示角色甲</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#演示角色甲</IRI>
        <Literal xml:lang="zh">Individuals 页：虚构教学角色；指挥链上级指向演示角色乙；演示编号 A01。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#演示角色乙</IRI>
        <Literal xml:lang="zh">演示角色乙</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#演示角色乙</IRI>
        <Literal xml:lang="zh">Individuals 页：虚构教学角色；指挥链上级指向演示角色丙；演示编号 A02。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#演示角色丙</IRI>
        <Literal xml:lang="zh">演示角色丙</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#演示角色丙</IRI>
        <Literal xml:lang="zh">Individuals 页：虚构教学角色；推理后可被甲间接指向；演示编号 A03。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#人物</IRI>
        <Literal xml:lang="zh">在 Classes 中选中人物 → Description → SubClass Of，双击某项能看到其 Manchester 语法；查看 Disjoint With 可找到势力、工具。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#武官</IRI>
        <Literal xml:lang="zh">在 Classes 查看 Equivalent To。Reasoner → HermiT → Start reasoner 后，切换 Inferred 查看赵云；不要手动添加赵云的武官类型。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#猛将</IRI>
        <Literal xml:lang="zh">在 DL Query 输入「猛将」，执行后查看 Instances，预期关羽、张飞、赵云出现。注意需要先运行推理机。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#蜀方人物</IRI>
        <Literal xml:lang="zh">在 DL Query 输入「蜀方人物」并执行，可通过属性链得到诸葛亮等与蜀有关的人物。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#使用</IRI>
        <Literal xml:lang="zh">在 Object Properties 中点击「使用」，观察 Inverse Of 和 Domain/Range；在 Individuals 中选关羽查看实例「使用 青龙刀」。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#属于</IRI>
        <Literal xml:lang="zh">在 Object Properties 中查看「执掌」是它的子属性、属性链在 SubProperty Of 中；启动推理后查看关羽的属于蜀。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#结义</IRI>
        <Literal xml:lang="zh">在 Object Properties → Characteristics 查看 Symmetric、Irreflexive；在 Individuals 中观察刘备和关羽的关系。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#指挥链上级</IRI>
        <Literal xml:lang="zh">在 Object Properties → Characteristics 查看 Transitive，再在 Individuals 中依次检查教学角色甲、乙、丙。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#武力值</IRI>
        <Literal xml:lang="zh">在 Data Properties 查看 Range=xsd:integer；在「猛将」Equivalent To 检查整数≥95约束。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#是否主公</IRI>
        <Literal xml:lang="zh">在 Data Properties 查看 Functional；Individuals 中刘备=true、关羽=false。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#演示评分</IRI>
        <Literal xml:lang="zh">Data Properties 中选中演示评分，Range=xsd:decimal；Sub Property Of 为演示总分；Individuals 中赵云=9.5。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#演示编号</IRI>
        <Literal xml:lang="zh">在 Data Properties 中选中演示编号，查看 Functional 和 Range=xsd:string；在 Classes → 教学角色中查看 Keys。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#教学角色</IRI>
        <Literal xml:lang="zh">在 Classes 中选中教学角色，查看 Keys=演示编号；三个虚构个体分别拥有 A01、A02、A03。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#教学提示</IRI>
        <Literal xml:lang="zh">在 Annotation Properties 里选「教学提示」，其下可见「练习提示」；它们只存放说明，不改变类和实例的语义。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#赵云</IRI>
        <Literal xml:lang="zh">对比 Reasoner 启动前后：赵云 Asserted Types（显式类型）为空，Inferred Types 出现人物、武官、猛将、蜀方人物。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#白龙马</IRI>
        <Literal xml:lang="zh">对比 Reasoner 启动前后，白龙马的 Inferred Types 应包含马。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#刘玄德</IRI>
        <Literal xml:lang="zh">在 Individuals 中点击刘玄德，查看 Same As；与刘备是同一个个体，因此其属性可共享。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#刘备</IRI>
        <Literal xml:lang="zh">在 Individuals 的 Same As 查看刘玄德；在 Object Property Assertions 查看结义，在 Negative Object Property Assertions 查看不骑乘赤兔马。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#教学提示"/>
        <IRI>#关羽</IRI>
        <Literal xml:lang="zh">在 Individuals 的 Negative Data Property Assertions 查看「武力值 != 60」；这是额外的否定数据断言示例。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#练习提示"/>
        <IRI>#猛将</IRI>
        <Literal xml:lang="zh">试着将数据属性「武力值」中的赵云数值97改为90（建议另存练习副本），重新启动推理机，观察猛将类型是否消失。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#练习提示"/>
        <IRI>#结义</IRI>
        <Literal xml:lang="zh">在刘备的对象属性断言中仅声明刘备结义关羽；无需额外填关羽结义刘备，推理机自动处理对称性。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#练习提示"/>
        <IRI>#指挥链上级</IRI>
        <Literal xml:lang="zh">删除教学角色乙→教学角色丙的断言并重跑推理，检查甲→丙是否还存在。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty IRI="#练习提示"/>
        <IRI>#赵云</IRI>
        <Literal xml:lang="zh">不要添加赵云的显式类型，否则不易区分 Asserted 和 Inferred；使用 Reasoner 检查分类结果。</Literal>
    </AnnotationAssertion>
</Ontology>
