    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#演示评分</IRI>
        <Literal xml:lang="zh">Data Properties：Range xsd:decimal；是「演示总分」的子属性。示例赵云为 9.5，仅为小数演示，不是史实评分。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#演示总分</IRI>
        <Literal xml:lang="zh">演示总分</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#演示总分</IRI>
        <Literal xml:lang="zh">Data Properties：Range xsd:decimal；上位数据属性，演示评分是它的子属性；9.5 可作为推理出的演示总分。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
