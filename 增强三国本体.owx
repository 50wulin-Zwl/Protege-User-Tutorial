    <!-- 教学增强：类的继承、等价类、互斥的示例 -->
    <SubClassOf>
        <Class IRI="#教学角色"/>
        <Class IRI="#人物"/>
    </SubClassOf>
    <EquivalentClasses>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="zh">Class → Equivalent To：满足人物且属于蜀势力者自动归入蜀方人物，依赖属性链的推理结果。</Literal>
        </Annotation>
        <Class IRI="#蜀方人物"/>
        <ObjectIntersectionOf>
            <Class IRI="#人物"/>
            <ObjectHasValue>
                <ObjectProperty IRI="#属于"/>
                <NamedIndividual IRI="#蜀"/>
            </ObjectHasValue>
        </ObjectIntersectionOf>
    </EquivalentClasses>
    <DisjointClasses>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="zh">Class → Disjoint With：本教学本体将武器与日常工具定义为互不相交的类别。</Literal>
        </Annotation>
        <Class IRI="#武器"/>
        <Class IRI="#日常工具"/>
    </DisjointClasses>
    <HasKey>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="zh">Classes → Keys：教学角色以演示编号为键，两个命名的教学角色若有同一编号，会被推断是同一个体。</Literal>
        </Annotation>
        <Class IRI="#教学角色"/>
        <DataProperty IRI="#演示编号"/>
    </HasKey>
    <!-- 教学增强：属性层级、特征、定义域和值域 -->
    <SubAnnotationPropertyOf>
        <AnnotationProperty IRI="#练习提示"/>
        <AnnotationProperty IRI="#教学提示"/>
