    <SubDataPropertyOf>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="zh">Data Properties → Sub Property Of：演示评分是演示总分的子属性，因而赵云有演示评分9.5也能推出演示总分9.5。</Literal>
        </Annotation>
        <DataProperty IRI="#演示评分"/>
