<?xml version='1.0' encoding='UTF-8'?>
<Ontology xmlns="http://www.w3.org/2002/07/owl#" xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:xsd="http://www.w3.org/2001/XMLSchema#" xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#" xml:base="http://www.semanticweb.org/93928/ontologies/2026/9/untitled-ontology-28" ontologyIRI="http://www.semanticweb.org/93928/ontologies/2026/9/untitled-ontology-28">
    <Prefix name="" IRI="http://www.semanticweb.org/93928/ontologies/2026/9/untitled-ontology-28/"/>
    <Prefix name="owl" IRI="http://www.w3.org/2002/07/owl#"/>
    <Prefix name="rdf" IRI="http://www.w3.org/1999/02/22-rdf-syntax-ns#"/>
    <Prefix name="xml" IRI="http://www.w3.org/XML/1998/namespace"/>
    <Prefix name="xsd" IRI="http://www.w3.org/2001/XMLSchema#"/>
    <Prefix name="rdfs" IRI="http://www.w3.org/2000/01/rdf-schema#"/>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <Literal xml:lang="zh">三国人物关系本体｜Protégé中文教学增强版</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <Literal xml:lang="zh">沿用原文件的三国人物、势力、武器、坐骑和推理规则。各个实体的 Annotations（注释）区域都有中文说明。新增少量注释属性、逻辑属性特征、实例断言及查询示例，用于认识 Protégé 各功能页。</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty abbreviatedIRI="owl:versionInfo"/>
        <Literal>中文学习演示版 1.0（保留原本体主体及赵云的推理示例）</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="#教学提示"/>
        <Literal xml:lang="zh">导航：Classes 查看层级/等价/互斥；Object Properties 查看逆属性、属性链、对称性与传递性；Data Properties 查看数据类型；Individuals by class 查看实例和断言；Reasoner 运行 HermiT；DL Query 手动输入示例查询。</Literal>
    </Annotation>
    <Annotation>
        <AnnotationProperty IRI="#练习提示"/>
        <Literal xml:lang="zh">DL Query 示例：人物 and (使用 some 武器)；武官 and (武力值 some xsd:integer[&gt;= 95])（不同版本对数据范围表达式支持不一）；蜀方人物。初学者优先查询「武官」「猛将」「蜀方人物」。</Literal>
    </Annotation>
    <!-- =================================================================== -->
    <!-- 1. 类声明 (Class Declarations)                                       -->
    <!-- =================================================================== -->
    <Declaration>
        <Class IRI="#人物"/>
    </Declaration>
    <Declaration>
        <Class IRI="#皇上"/>
    </Declaration>
    <Declaration>
        <Class IRI="#文官"/>
    </Declaration>
    <Declaration>
        <Class IRI="#武官"/>
    </Declaration>
    <Declaration>
        <Class IRI="#猛将"/>
    </Declaration>
    <Declaration>
        <Class IRI="#势力"/>
    </Declaration>
    <Declaration>
        <Class IRI="#工具"/>
    </Declaration>
    <Declaration>
        <Class IRI="#武器"/>
    </Declaration>
    <Declaration>
        <Class IRI="#日常工具"/>
    </Declaration>
    <Declaration>
        <Class IRI="#马"/>
    </Declaration>
    <!-- =================================================================== -->
    <!-- 2. 对象属性声明 (Object Property Declarations)                       -->
    <!-- =================================================================== -->
    <Declaration>
        <ObjectProperty IRI="#使用"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#被使用"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#骑乘"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#被骑乘"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#属于"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#拥有成员"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#执掌"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#忠诚于"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#统领"/>
    </Declaration>
    <!-- =================================================================== -->
    <!-- 3. 数据属性声明 (Data Property Declarations)                         -->
    <!-- =================================================================== -->
    <Declaration>
        <DataProperty IRI="#字"/>
    </Declaration>
    <Declaration>
        <DataProperty IRI="#武力值"/>
    </Declaration>
    <!-- =================================================================== -->
    <!-- 4. 个体/实例声明 (Named Individual Declarations)                     -->
    <!-- =================================================================== -->
    <Declaration>
        <NamedIndividual IRI="#刘备"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#关羽"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#张飞"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#赵云"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#诸葛亮"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#蜀"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#青龙刀"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#丈八蛇矛"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#龙胆枪"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#双股剑"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#羽扇"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#赤兔马"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#的卢马"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#乌云踏雪"/>
    </Declaration>
    <Declaration>
        <NamedIndividual IRI="#白龙马"/>
    </Declaration>
    <!-- =================================================================== -->
    <!-- 5. 基础类层级关系 (Named Class Hierarchy)                            -->
    <!-- =================================================================== -->
    <SubClassOf>
        <Class IRI="#皇上"/>
        <Class IRI="#人物"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#文官"/>
        <Class IRI="#人物"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#武官"/>
        <Class IRI="#人物"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#猛将"/>
        <Class IRI="#武官"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#武器"/>
        <Class IRI="#工具"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#日常工具"/>
        <Class IRI="#工具"/>
    </SubClassOf>
    <SubClassOf>
        <Class IRI="#马"/>
        <Class IRI="#工具"/>
    </SubClassOf>
    <!-- 顶层类别互斥：人物、工具、势力两两不相交 -->
    <DisjointClasses>
        <Class IRI="#人物"/>
        <Class IRI="#工具"/>
        <Class IRI="#势力"/>
    </DisjointClasses>
    <!-- =================================================================== -->
    <!-- 6. 触发推理机亮黄色分类的核心：EquivalentClasses (等价类/充要条件)    -->
    <!-- =================================================================== -->
    <!-- [推理规则 1] 武官的充要条件：凡是【人物】且【使用 some 武器】且【骑乘 some 马】且【忠诚于 some 皇上】，自动推理为【武官】！ -->
    <!-- 测试效果：赵云没有手写类型是武官，开启推理后会被自动推导为【武官】！ -->
    <EquivalentClasses>
        <Class IRI="#武官"/>
        <ObjectIntersectionOf>
            <Class IRI="#人物"/>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#使用"/>
                <Class IRI="#武器"/>
            </ObjectSomeValuesFrom>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#骑乘"/>
                <Class IRI="#马"/>
            </ObjectSomeValuesFrom>
            <ObjectSomeValuesFrom>
                <ObjectProperty IRI="#忠诚于"/>
                <Class IRI="#皇上"/>
            </ObjectSomeValuesFrom>
        </ObjectIntersectionOf>
    </EquivalentClasses>
    <!-- [推理规则 2] 猛将的充要条件：凡是【武官】且【武力值 >= 95】，自动推理为【猛将】！ -->
    <!-- 测试效果：关羽(97)、张飞(98)、赵云(97) 都没有手写是猛将，开启推理后全部亮黄色归入【猛将】！ -->
    <EquivalentClasses>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="zh">公理注释示例：这一整条等价类公理解释了「武力值至少95」如何触发猛将分类。</Literal>
        </Annotation>
        <Class IRI="#猛将"/>
        <ObjectIntersectionOf>
            <Class IRI="#武官"/>
            <DataSomeValuesFrom>
                <DataProperty IRI="#武力值"/>
                <DatatypeRestriction>
                    <Datatype abbreviatedIRI="xsd:integer"/>
                    <FacetRestriction facet="http://www.w3.org/2001/XMLSchema#minInclusive">
                        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">95</Literal>
                    </FacetRestriction>
                </DatatypeRestriction>
            </DataSomeValuesFrom>
        </ObjectIntersectionOf>
    </EquivalentClasses>
    <!-- =================================================================== -->
    <!-- 7. SubClassOf 匿名公理约束 (对应 Protégé 的 SubClass Of)             -->
    <!-- =================================================================== -->
    <!-- [人物] 约束 1：属于 some 势力（原 exactly 1 与属性链不符合 OWL 2 DL 非简单属性限制，改为存在性限制） -->
    <SubClassOf>
        <Class IRI="#人物"/>
        <ObjectSomeValuesFrom>
            <ObjectProperty IRI="#属于"/>
            <Class IRI="#势力"/>
        </ObjectSomeValuesFrom>
    </SubClassOf>
    <!-- [人物] 约束 2：字 max 1 string -->
    <SubClassOf>
        <Class IRI="#人物"/>
        <DataMaxCardinality cardinality="1">
            <DataProperty IRI="#字"/>
            <Datatype abbreviatedIRI="xsd:string"/>
        </DataMaxCardinality>
    </SubClassOf>
    <!-- [人物] 约束 3：骑乘 min 0 马 -->
    <SubClassOf>
        <Class IRI="#人物"/>
        <ObjectMinCardinality cardinality="0">
            <ObjectProperty IRI="#骑乘"/>
            <Class IRI="#马"/>
        </ObjectMinCardinality>
    </SubClassOf>
    <!-- [人物] 约束 4：使用 min 0 工具 -->
    <SubClassOf>
        <Class IRI="#人物"/>
        <ObjectMinCardinality cardinality="0">
            <ObjectProperty IRI="#使用"/>
            <Class IRI="#工具"/>
        </ObjectMinCardinality>
    </SubClassOf>
    <!-- [皇上] 专属约束：执掌 exactly 1 势力 -->
    <SubClassOf>
        <Class IRI="#皇上"/>
        <ObjectExactCardinality cardinality="1">
            <ObjectProperty IRI="#执掌"/>
            <Class IRI="#势力"/>
        </ObjectExactCardinality>
    </SubClassOf>
    <!-- [武官] 专属约束：忠诚于 exactly 1 皇上 -->
    <SubClassOf>
        <Class IRI="#武官"/>
        <ObjectExactCardinality cardinality="1">
            <ObjectProperty IRI="#忠诚于"/>
            <Class IRI="#皇上"/>
        </ObjectExactCardinality>
    </SubClassOf>
    <!-- [文官] 专属约束 1：忠诚于 exactly 1 皇上 -->
    <SubClassOf>
        <Class IRI="#文官"/>
        <ObjectExactCardinality cardinality="1">
            <ObjectProperty IRI="#忠诚于"/>
            <Class IRI="#皇上"/>
        </ObjectExactCardinality>
    </SubClassOf>
    <!-- [文官] 专属约束 2：使用 min 0 日常工具 -->
    <SubClassOf>
        <Class IRI="#文官"/>
        <ObjectMinCardinality cardinality="0">
            <ObjectProperty IRI="#使用"/>
            <Class IRI="#日常工具"/>
        </ObjectMinCardinality>
    </SubClassOf>
    <!-- =================================================================== -->
    <!-- 8. 触发属性自动推理的核心：子属性、逆属性与属性链                     -->
    <!-- =================================================================== -->
    <!-- [推理规则 3：子属性推理] 执掌 是 属于 的子属性 -->
    <!-- 刘备只写了【执掌 蜀】，没写【属于 蜀】；开启推理后自动推出【刘备 属于 蜀】！ -->
    <SubObjectPropertyOf>
        <ObjectProperty IRI="#执掌"/>
        <ObjectProperty IRI="#属于"/>
    </SubObjectPropertyOf>
    <!-- [推理规则 4：属性链推理 (Property Chain)] 忠诚于 o 执掌 -> 属于 -->
    <!-- 如果 A 忠诚于 B，且 B 执掌 C，则自动推出 A 属于 C！ -->
    <!-- 关羽、张飞、赵云、诸葛亮 都没手写【属于 蜀】，开启推理后全部自动推出【属于 蜀】！ -->
    <SubObjectPropertyOf>
        <ObjectPropertyChain>
            <ObjectProperty IRI="#忠诚于"/>
            <ObjectProperty IRI="#执掌"/>
        </ObjectPropertyChain>
        <ObjectProperty IRI="#属于"/>
    </SubObjectPropertyOf>
    <!-- [推理规则 5：逆属性推理 (InverseOf)] 自动反向连边 -->
    <InverseObjectProperties>
        <ObjectProperty IRI="#统领"/>
        <ObjectProperty IRI="#忠诚于"/>
    </InverseObjectProperties>
    <InverseObjectProperties>
        <ObjectProperty IRI="#被使用"/>
        <ObjectProperty IRI="#使用"/>
    </InverseObjectProperties>
    <InverseObjectProperties>
        <ObjectProperty IRI="#被骑乘"/>
        <ObjectProperty IRI="#骑乘"/>
    </InverseObjectProperties>
    <InverseObjectProperties>
        <ObjectProperty IRI="#拥有成员"/>
        <ObjectProperty IRI="#属于"/>
    </InverseObjectProperties>
    <!-- 属性定义域与值域 (Domains & Ranges) —— 也会触发自动类型推导！ -->
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#使用"/>
        <Class IRI="#人物"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#使用"/>
        <Class IRI="#工具"/>
    </ObjectPropertyRange>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#属于"/>
        <Class IRI="#人物"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#属于"/>
        <Class IRI="#势力"/>
    </ObjectPropertyRange>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#执掌"/>
        <Class IRI="#皇上"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#执掌"/>
        <Class IRI="#势力"/>
    </ObjectPropertyRange>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#忠诚于"/>
        <ObjectUnionOf>
            <Class IRI="#文官"/>
            <Class IRI="#武官"/>
        </ObjectUnionOf>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#忠诚于"/>
        <Class IRI="#皇上"/>
    </ObjectPropertyRange>
    <ObjectPropertyDomain>
        <ObjectProperty IRI="#骑乘"/>
        <Class IRI="#人物"/>
    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#骑乘"/>
        <Class IRI="#马"/>
    </ObjectPropertyRange>
    <DataPropertyDomain>
        <DataProperty IRI="#字"/>
        <Class IRI="#人物"/>
    </DataPropertyDomain>
    <DataPropertyRange>
        <DataProperty IRI="#字"/>
        <Datatype abbreviatedIRI="xsd:string"/>
    </DataPropertyRange>
    <DataPropertyDomain>
        <DataProperty IRI="#武力值"/>
        <Class IRI="#人物"/>
    </DataPropertyDomain>
    <DataPropertyRange>
        <DataProperty IRI="#武力值"/>
        <Datatype abbreviatedIRI="xsd:integer"/>
    </DataPropertyRange>
    <!-- =================================================================== -->
    <!-- 9. 实例类型断言 (刻意留白部分类型，让推理机自动推导出来！)            -->
    <!-- =================================================================== -->
    <ClassAssertion>
        <Class IRI="#皇上"/>
        <NamedIndividual IRI="#刘备"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#武官"/>
        <NamedIndividual IRI="#关羽"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#武官"/>
        <NamedIndividual IRI="#张飞"/>
    </ClassAssertion>
    <!-- 注意：这里故意【不写】赵云是武官、甚至不写赵云是人物，也不写白龙马是马！全靠推理机自动推导！ -->
    <ClassAssertion>
        <Class IRI="#文官"/>
        <NamedIndividual IRI="#诸葛亮"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#势力"/>
        <NamedIndividual IRI="#蜀"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#武器"/>
        <NamedIndividual IRI="#青龙刀"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#武器"/>
        <NamedIndividual IRI="#丈八蛇矛"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#武器"/>
        <NamedIndividual IRI="#龙胆枪"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#武器"/>
        <NamedIndividual IRI="#双股剑"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#日常工具"/>
        <NamedIndividual IRI="#羽扇"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#马"/>
        <NamedIndividual IRI="#赤兔马"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#马"/>
        <NamedIndividual IRI="#的卢马"/>
    </ClassAssertion>
    <ClassAssertion>
        <Class IRI="#马"/>
        <NamedIndividual IRI="#乌云踏雪"/>
    </ClassAssertion>
    <!-- =================================================================== -->
    <!-- 10. 实例属性断言 (故意不写“属于 蜀”，看推理机如何自动推导！)          -->
    <!-- =================================================================== -->
    <!-- 刘备：只写【执掌 蜀】，不写【属于 蜀】；开启推理后自动推出【属于 蜀】与【统领 关羽/张飞/赵云/诸葛亮】 -->
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#执掌"/>
        <NamedIndividual IRI="#刘备"/>
        <NamedIndividual IRI="#蜀"/>
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#使用"/>
        <NamedIndividual IRI="#刘备"/>
        <NamedIndividual IRI="#双股剑"/>
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#骑乘"/>
        <NamedIndividual IRI="#刘备"/>
        <NamedIndividual IRI="#的卢马"/>
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#字"/>
        <NamedIndividual IRI="#刘备"/>
        <Literal>玄德</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#武力值"/>
        <NamedIndividual IRI="#刘备"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">75</Literal>
    </DataPropertyAssertion>
    <!-- 关羽：只写忠诚于刘备、武力值97；开启推理后自动推出【属于 蜀】和【类型：猛将】 -->
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#使用"/>
        <NamedIndividual IRI="#关羽"/>
        <NamedIndividual IRI="#青龙刀"/>
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#骑乘"/>
        <NamedIndividual IRI="#关羽"/>
        <NamedIndividual IRI="#赤兔马"/>
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#忠诚于"/>
        <NamedIndividual IRI="#关羽"/>
        <NamedIndividual IRI="#刘备"/>
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#字"/>
        <NamedIndividual IRI="#关羽"/>
        <Literal>云长</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#武力值"/>
        <NamedIndividual IRI="#关羽"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">97</Literal>
    </DataPropertyAssertion>
    <!-- 张飞：只写忠诚于刘备、武力值98；开启推理后自动推出【属于 蜀】和【类型：猛将】 -->
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#使用"/>
        <NamedIndividual IRI="#张飞"/>
        <NamedIndividual IRI="#丈八蛇矛"/>
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#骑乘"/>
        <NamedIndividual IRI="#张飞"/>
        <NamedIndividual IRI="#乌云踏雪"/>
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#忠诚于"/>
        <NamedIndividual IRI="#张飞"/>
        <NamedIndividual IRI="#刘备"/>
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#字"/>
        <NamedIndividual IRI="#张飞"/>
        <Literal>翼德</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#武力值"/>
        <NamedIndividual IRI="#张飞"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">98</Literal>
    </DataPropertyAssertion>
    <!-- 赵云：故意没写任何类型（连“人物”都没写！），开启推理后自动推出【人物 -> 武官 -> 猛将】且【属于 蜀】！ -->
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#使用"/>
        <NamedIndividual IRI="#赵云"/>
        <NamedIndividual IRI="#龙胆枪"/>
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#骑乘"/>
        <NamedIndividual IRI="#赵云"/>
        <NamedIndividual IRI="#白龙马"/>
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#忠诚于"/>
        <NamedIndividual IRI="#赵云"/>
        <NamedIndividual IRI="#刘备"/>
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#字"/>
        <NamedIndividual IRI="#赵云"/>
        <Literal>子龙</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#武力值"/>
        <NamedIndividual IRI="#赵云"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#integer">97</Literal>
    </DataPropertyAssertion>
    <!-- 诸葛亮：只写忠诚于刘备；开启推理后自动推出【属于 蜀】 -->
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#忠诚于"/>
        <NamedIndividual IRI="#诸葛亮"/>
        <NamedIndividual IRI="#刘备"/>
    </ObjectPropertyAssertion>
    <ObjectPropertyAssertion>
        <ObjectProperty IRI="#使用"/>
        <NamedIndividual IRI="#诸葛亮"/>
        <NamedIndividual IRI="#羽扇"/>
    </ObjectPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#字"/>
        <NamedIndividual IRI="#诸葛亮"/>
        <Literal>孔明</Literal>
    </DataPropertyAssertion>
    <!-- 教学增强：声明——新类、对象属性、数据属性、注释属性与个体 -->
    <Declaration>
        <Class IRI="#蜀方人物"/>
    </Declaration>
    <Declaration>
        <Class IRI="#教学角色"/>
    </Declaration>
    <Declaration>
        <ObjectProperty IRI="#结义"/>
    </Declaration>
    <Declaration>
