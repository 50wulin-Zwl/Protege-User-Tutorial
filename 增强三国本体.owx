    </ObjectPropertyDomain>
    <ObjectPropertyRange>
        <ObjectProperty IRI="#指挥链上级"/>
        <Class IRI="#人物"/>
    </ObjectPropertyRange>
    <FunctionalObjectProperty>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="zh">同一统治者最多执掌一个势力；用于 Object Properties → Characteristics 的 Functional 示例。</Literal>
        </Annotation>
        <ObjectProperty IRI="#执掌"/>
    </FunctionalObjectProperty>
    <SymmetricObjectProperty>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="zh">结义是对称关系：刘备结义关羽，则推理得关羽结义刘备。</Literal>
        </Annotation>
        <ObjectProperty IRI="#结义"/>
    </SymmetricObjectProperty>
    <IrreflexiveObjectProperty>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="zh">结义为非自反关系：任何个体不能与自己结义。</Literal>
        </Annotation>
        <ObjectProperty IRI="#结义"/>
    </IrreflexiveObjectProperty>
    <TransitiveObjectProperty>
        <Annotation>
            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="zh">传递关系（虚构练习角色）：甲高于乙、乙高于丙，可推理甲高于丙。</Literal>
        </Annotation>
        <ObjectProperty IRI="#指挥链上级"/>
    </TransitiveObjectProperty>
