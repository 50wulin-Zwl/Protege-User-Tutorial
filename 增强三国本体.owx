            <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
            <Literal xml:lang="zh">教学角色的演示编号最多一个值，并用 HasKey 展示键功能。</Literal>
        </Annotation>
        <DataProperty IRI="#演示编号"/>
    </FunctionalDataProperty>
