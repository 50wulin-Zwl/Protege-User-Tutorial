    <!-- 教学增强：为原有及新增实体添加中文标签、说明及具体操作提示 -->
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#人物</IRI>
        <Literal xml:lang="zh">人物</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#人物</IRI>
        <Literal xml:lang="zh">Classes 页：点开 SubClass Of 查看上位类及「属于 some 势力」「字 max 1」等约束；其中「骑乘 min 0」只用于展示语法，实际上不增加限制。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#皇上</IRI>
        <Literal xml:lang="zh">皇上</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#皇上</IRI>
        <Literal xml:lang="zh">Classes 页：人物的子类；SubClass Of 存在「执掌 exactly 1 势力」；点击 Individuals 查看刘备。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#文官</IRI>
        <Literal xml:lang="zh">文官</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#文官</IRI>
        <Literal xml:lang="zh">Classes 页：人物的子类；诸葛亮为实例，查看「忠诚于 exactly 1 皇上」。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#武官</IRI>
        <Literal xml:lang="zh">武官</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#武官</IRI>
        <Literal xml:lang="zh">Classes 页：Equivalent To 提供充要条件：人物且使用武器、骑乘马、忠诚于皇上。启动推理机后赵云可被归入武官。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#猛将</IRI>
        <Literal xml:lang="zh">猛将</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#猛将</IRI>
        <Literal xml:lang="zh">Classes 页：武官的子类；Equivalent To 的整数范围限制为武力值≥95。推理机应把关羽、张飞、赵云归入猛将。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#势力</IRI>
        <Literal xml:lang="zh">势力</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#势力</IRI>
        <Literal xml:lang="zh">顶层类之一，与人物、工具互斥；现有实例「蜀」；Object Properties 的属于/执掌值域为势力。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#工具</IRI>
        <Literal xml:lang="zh">工具</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#工具</IRI>
        <Literal xml:lang="zh">上位类，下有武器、日常工具、马；马归入工具是原本体教学抽象，并非现实中的严谨生物分类。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#武器</IRI>
        <Literal xml:lang="zh">武器</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#武器</IRI>
        <Literal xml:lang="zh">工具的子类；与日常工具设置 Disjoint With（互斥）。实例有青龙刀、丈八蛇矛等。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#日常工具</IRI>
        <Literal xml:lang="zh">日常工具</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#日常工具</IRI>
        <Literal xml:lang="zh">工具的子类；与武器互斥。羽扇为实例；诸葛亮使用羽扇。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#马</IRI>
        <Literal xml:lang="zh">马</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#马</IRI>
        <Literal xml:lang="zh">工具的子类（沿用原模型）。注意白龙马没有显式指定类型，推理机可以从「赵云 骑乘 白龙马」的值域推出它属于马。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#蜀方人物</IRI>
        <Literal xml:lang="zh">蜀方人物</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#蜀方人物</IRI>
        <Literal xml:lang="zh">新增教学类：Equivalent To 为「人物 and (属于 value 蜀)」；当推理机推断出属于蜀时，可将相关人物自动归类。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#教学角色</IRI>
        <Literal xml:lang="zh">教学角色</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#教学角色</IRI>
        <Literal xml:lang="zh">虚构练习人物的子类：用于演示传递属性「指挥链上级」及 Keys（键）功能，与三国史实无关。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#使用</IRI>
        <Literal xml:lang="zh">使用</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#使用</IRI>
        <Literal xml:lang="zh">Object Properties：主语是人物，宾语是工具；与「被使用」互为逆属性。例：关羽 使用 青龙刀。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#被使用</IRI>
        <Literal xml:lang="zh">被使用</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#被使用</IRI>
        <Literal xml:lang="zh">Object Properties：与「使用」互为 Inverse Of。推理后可由关羽使用青龙刀推出青龙刀被关羽使用。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#骑乘</IRI>
        <Literal xml:lang="zh">骑乘</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#骑乘</IRI>
        <Literal xml:lang="zh">Object Properties：Domain 人物、Range 马；Inverse Of 被骑乘。例：赵云骑乘白龙马，促进推理白龙马是马。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#被骑乘</IRI>
        <Literal xml:lang="zh">被骑乘</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#被骑乘</IRI>
        <Literal xml:lang="zh">Object Properties：与「骑乘」互为逆属性，推理后可看到马被人物骑乘。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#属于</IRI>
        <Literal xml:lang="zh">属于</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#属于</IRI>
        <Literal xml:lang="zh">Object Properties：Domain 人物、Range 势力；有子属性「执掌」并作为属性链「忠诚于 o 执掌」的结果。因为属于为非简单属性，不能用于基数 exactly 1。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#拥有成员</IRI>
        <Literal xml:lang="zh">拥有成员</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#拥有成员</IRI>
        <Literal xml:lang="zh">Object Properties：属于的逆属性；推理后蜀拥有成员刘备、关羽等。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#执掌</IRI>
        <Literal xml:lang="zh">执掌</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#执掌</IRI>
        <Literal xml:lang="zh">Object Properties：属于的子属性；特征 Functional；例：刘备执掌蜀。此属性在皇上类中可用于 exactly 1 限制。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#忠诚于</IRI>
        <Literal xml:lang="zh">忠诚于</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#忠诚于</IRI>
        <Literal xml:lang="zh">Object Properties：Inverse Of 统领；Domain 为文官 or 武官（OWL逻辑并集），Range 为皇上。例：关羽忠诚于刘备。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#统领</IRI>
        <Literal xml:lang="zh">统领</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#统领</IRI>
        <Literal xml:lang="zh">Object Properties：忠诚于的逆属性；刘备统领关羽等关系由推理得到，无需重复手工声明。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#结义</IRI>
        <Literal xml:lang="zh">结义</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#结义</IRI>
        <Literal xml:lang="zh">Object Properties：Characteristics 中勾选 Symmetric（对称）、Irreflexive（非自反）。刘备结义关羽可推得关羽结义刘备。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#指挥链上级</IRI>
        <Literal xml:lang="zh">指挥链上级</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#指挥链上级</IRI>
        <Literal xml:lang="zh">Object Properties：Characteristics 中设置 Transitive（传递）。虚构甲→乙→丙，推理得甲→丙；仅是练习数据。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#字</IRI>
        <Literal xml:lang="zh">字</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#字</IRI>
        <Literal xml:lang="zh">Data Properties：Domain 人物，Range xsd:string。例：关羽的字为云长；人物类另设字 max 1 string。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#武力值</IRI>
        <Literal xml:lang="zh">武力值</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#武力值</IRI>
        <Literal xml:lang="zh">Data Properties：Range xsd:integer。数值为本体演示设定，不作历史真实性声明；用于猛将的武力值≥95等价类。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#是否主公</IRI>
        <Literal xml:lang="zh">是否主公</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#是否主公</IRI>
        <Literal xml:lang="zh">Data Properties：Range xsd:boolean、Domain 人物、Functional。刘备为 true，关羽为 false，展示布尔值。</Literal>
    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:label"/>
        <IRI>#演示评分</IRI>
