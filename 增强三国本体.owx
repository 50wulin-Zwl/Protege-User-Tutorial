    </AnnotationAssertion>
    <AnnotationAssertion>
        <AnnotationProperty abbreviatedIRI="rdfs:comment"/>
        <IRI>#赵云</IRI>
        <Literal xml:lang="zh">重点推理示例：刻意不直接声明他是人物、武官、猛将。由使用、骑乘、忠诚于、武力值97，启动 Reasoner 后自动归入这些类。</Literal>
    </AnnotationAssertion>
